# ==========================================================================
# JURIFY — variáveis de ambiente para PRODUÇÃO (Vercel)
# ==========================================================================
# Configure em: https://vercel.com/[seu-usuario]/jurify-app/settings/environment-variables
# Todas as `VITE_*` ficam no Vercel. Chaves de servidor (STRIPE_SECRET_KEY,
# GOOGLE_CLIENT_SECRET, ENCRYPTION_KEY, POSTMARK_SERVER_TOKEN, etc.) NÃO vão
# aqui — ficam em Supabase Edge Function Secrets. Ver SETUP-REQUIRED.md.
# ==========================================================================

# --- Supabase (obrigatório) -------------------------------------------------
VITE_SUPABASE_URL=https://yfxgncbopvnsltjqetxw.supabase.co
VITE_SUPABASE_ANON_KEY=<your_supabase_anon_key_from_dashboard>

# --- App config -------------------------------------------------------------
VITE_APP_VERSION=2.1.0
VITE_APP_NAME=Jurify
VITE_APP_DOMAIN=jurify.com.br
VITE_USE_MOCK=false

# --- Stripe (desbloqueia cobrança) -----------------------------------------
# Crie produtos em https://dashboard.stripe.com/products e cole os price_ids.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_STRIPE_PRICE_PRO=price_...
VITE_STRIPE_PRICE_ENTERPRISE=price_...

# --- Sentry (observabilidade em prod) --------------------------------------
# Criar projeto React/Vite em https://sentry.io
VITE_SENTRY_DSN=

# --- Google OAuth (Calendar + Drive) ---------------------------------------
# OAuth client Web em https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=https://jurify-app.vercel.app/auth/google/callback

# --- ZapSign (assinatura digital) ------------------------------------------
VITE_ZAPSIGN_API_URL=https://api.zapsign.com.br/api/v1
VITE_ZAPSIGN_SANDBOX=false

# --- Status page + vendas --------------------------------------------------
# Token opcional para ver detalhes em /status (se vazio, /status mostra só básico)
VITE_PUBLIC_STATUS_TOKEN=
# Telefone do WhatsApp comercial (CTA em /pricing)
VITE_SALES_WHATSAPP=5596981419460

# --- Segurança -------------------------------------------------------------
VITE_RATE_LIMIT_MAX=100
VITE_RATE_LIMIT_WINDOW=60000

# --- Analytics (opcional) --------------------------------------------------
VITE_GOOGLE_ANALYTICS_ID=

# --- Debug (sempre off em prod) --------------------------------------------
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=error
VITE_ENABLE_CONSOLE_LOGS=false
